{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/tmp/fastfetch_cover.jpg",
    "width": 28,
    "height": 14,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "31"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "32"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "33"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "34"
    },
    {
      "type": "packages",
      "key": "󰏖 Paquetes",
      "keyColor": "35"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "31"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "32"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "33"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "34"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "35"
    },
    "break",
    {
      "type": "media",
      "key": "󰎈 Reproduciendo",
      "keyColor": "36"
    },
    "break",
    "colors"
  ]
}
